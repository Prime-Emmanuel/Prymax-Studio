# Clé API Resend côté serveur uniquement (https://resend.com/api-keys)
# IMPORTANT : Ne jamais préfixer par VITE_ ou NEXT_PUBLIC_
RESEND_API_KEY=re_votre_cle_api_resend

# Identité d'expédition officielle du domaine vérifié prymaxstudio.com
RESEND_FROM_EMAIL="PRYMAX STUDIO <hello@prymaxstudio.com>"

# Adresse de réception principale du studio (et Reply-To)
STUDIO_NOTIFICATION_EMAIL="prymaxstudio@gmail.com"

# ID de l'Audience Resend pour la sauvegarde cloud persistante des abonnés Newsletter (https://resend.com/audiences)
RESEND_AUDIENCE_ID=
