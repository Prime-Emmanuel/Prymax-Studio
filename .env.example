# Clé API Resend côté serveur uniquement (https://resend.com/api-keys)
# IMPORTANT : Doit avoir la permission "Full access" pour enregistrer les contacts dans Resend Contacts ET envoyer les emails.
# Ne jamais préfixer par VITE_ ou NEXT_PUBLIC_.
RESEND_API_KEY=re_votre_cle_api_resend

# Identité d'expédition officielle du domaine vérifié prymaxstudio.com (optionnel, valeur par défaut intégrée)
RESEND_FROM_EMAIL="PRYMAX STUDIO <hello@prymaxstudio.com>"

# Adresse de réception principale du studio et Reply-To (optionnel, valeur par défaut intégrée)
STUDIO_NOTIFICATION_EMAIL="prymaxstudio@gmail.com"

# Optionnel : Identifiant d'un Segment Resend si vous souhaitez rattacher les abonnés à un segment spécifique.
# Laissez vide pour enregistrer directement dans la liste globale Contacts de Resend sans segment supplémentaire.
RESEND_SEGMENT_ID=
